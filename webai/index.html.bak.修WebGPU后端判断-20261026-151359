<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>网页端本地 AI 推理 Demo</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: linear-gradient(160deg, #0a1628 0%, #0d2137 100%);
  color: #d8e6f5; min-height: 100vh; padding: 14px; line-height: 1.6;
}
.wrap { max-width: 900px; margin: 0 auto; }
h1 { font-size: 18px; color: #7dd3fc; margin-bottom: 4px; }
.sub { font-size: 12px; color: #6b8299; margin-bottom: 14px; }
.card {
  background: rgba(15, 32, 51, 0.85); border: 1px solid #1e3a5f;
  border-radius: 10px; padding: 14px; margin-bottom: 12px;
}
.env { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; font-size: 12px; }
.env div { background: #0d2137; padding: 7px 9px; border-radius: 6px; border: 1px solid #1a3050; }
.env b { color: #7dd3fc; display: block; font-size: 11px; font-weight: 500; margin-bottom: 2px; }
.ok { color: #4ade80; } .bad { color: #f87171; } .warn { color: #fbbf24; }
button {
  background: #1d4ed8; color: #fff; border: 0; padding: 9px 18px;
  border-radius: 7px; font-size: 13px; cursor: pointer; font-weight: 500;
}
button:hover:not(:disabled) { background: #2563eb; }
button:disabled { background: #334155; color: #64748b; cursor: not-allowed; }
.bar { height: 6px; background: #1a3050; border-radius: 3px; overflow: hidden; margin: 9px 0 5px; }
.bar > div { height: 100%; width: 0; background: linear-gradient(90deg, #3b82f6, #22d3ee); transition: width .25s; }
.status { font-size: 12px; color: #7dd3fc; min-height: 18px; }
textarea {
  width: 100%; background: #0d2137; border: 1px solid #1a3050; color: #d8e6f5;
  border-radius: 7px; padding: 9px; font-size: 13px; font-family: inherit; resize: vertical;
}
#out {
  background: #0a1a2e; border: 1px solid #1a3050; border-radius: 7px;
  padding: 10px; min-height: 100px; font-size: 13px; white-space: pre-wrap;
  word-break: break-word; max-height: 340px; overflow-y: auto;
}
.meta { font-size: 11px; color: #6b8299; margin-top: 6px; display: flex; gap: 14px; flex-wrap: wrap; }
.version { position: fixed; bottom: 6px; right: 9px; font-size: 10px; color: #3f5771; }
label { font-size: 12px; color: #8ba8c4; display: block; margin: 8px 0 4px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>🐳 网页端本地 AI 推理 Demo</h1>
  <div class="sub">模型跑在你自己的浏览器里，不连服务器，不花 API 费用</div>

  <div class="card">
    <div class="env" id="env">
      <div><b>WebGPU</b><span id="e-gpu">检测中…</span></div>
      <div><b>CPU 核心</b><span id="e-cpu">-</span></div>
      <div><b>内存</b><span id="e-mem">-</span></div>
      <div><b>运行后端</b><span id="e-backend">-</span></div>
    </div>
  </div>

  <div class="card">
    <label>选择模型</label>
    <select id="model" style="width:100%;background:#0d2137;border:1px solid #1a3050;color:#d8e6f5;border-radius:7px;padding:9px;font-size:13px;">
      <option value="onnx-community/Qwen2.5-0.5B-Instruct" data-size="460">Qwen2.5-0.5B-Instruct（中文，约 460MB）</option>
      <option value="Xenova/distilgpt2" data-size="80">distilgpt2（英文，约 80MB，快但只会续写）</option>
    </select>
    <div style="margin-top:10px">
      <button id="run2" disabled>准备中…</button>
    </div>
  </div>

  <div class="card">
    <label>输入</label>
    <textarea id="inp" rows="3" placeholder="加载完成后在这里输入…">用一句话介绍你自己</textarea>
    <div style="margin-top:9px">
      <button id="run" disabled>生成</button>
    </div>
    <label style="margin-top:12px">输出</label>
    <div id="out">（等待生成）</div>
    <div class="meta">
      <span id="m-speed">速度: -</span>
      <span id="m-tokens">token: -</span>
      <span id="m-time">耗时: -</span>
    </div>
  </div>
</div>
<div id="status" class="status" style="display:none"></div>
<div id="bar" style="display:none"></div>
<div class="version">v1.2.0-修库版本与错误提示 20261026</div>

<script type="module">
const $ = id => document.getElementById(id);

let pipe = null, ready = false, booting = null, currentModel = null;
const LIB_CDNS = [
  'https://cdn.jsdelivr.net/npm/@huggingface/transformers@4.3.1',
  'https://unpkg.com/@huggingface/transformers@4.3.1',
  'https://fastly.jsdelivr.net/npm/@huggingface/transformers@4.3.1'
];
let _lib = null;

async function getLib() {
  if (_lib) return _lib;
  const fails = [];
  for (const url of LIB_CDNS) {
    try { _lib = await import(url); return _lib; }
    catch (e) { fails.push(url.split('/')[2] + ': ' + String(e.message || e).slice(0, 60)); }
  }
  throw new Error('运行库加载失败 || ' + fails.join(' | '));
}

function setBtn(txt, enabled) {
  const b = $('run2');
  b.textContent = txt;
  b.disabled = !enabled;
}

// 静默预载：页面一打开就在后台跑，不提示、不显示进度
async function boot() {
  if (booting) return booting;
  booting = (async () => {
    try {
      const { pipeline, env } = await getLib();
      env.allowLocalModels = false;
      env.remoteHost = 'https://hf-mirror.com';

      const modelId = $('model').value;
      currentModel = modelId;
      const hasGpu = !!navigator.gpu;
      const device = hasGpu ? 'webgpu' : 'wasm';
      $('e-backend').textContent = device.toUpperCase();

      pipe = await pipeline('text-generation', modelId, {
        device,
        dtype: device === 'webgpu' ? 'q4f16' : 'q8'
        // 无 progress_callback：后台静默下载，不打扰用户
      });
      ready = true;
      setBtn('生成', true);
    } catch (e) {
      console.error(e);
      const msg = String((e && e.message) || e).slice(0, 200);
      setBtn('重试', true);
      $('out').textContent = '模型加载失败：' + msg + '\n\n（点按钮重试；若反复失败，多半是网络拉不到模型文件）';
      $('run2').onclick = () => { booting = null; ready = false; $('out').textContent = ''; setBtn('准备中…', false); boot(); };
    }
  })();
  return booting;
}

// 环境检测（保持可见，这几个格子有用）
(async () => {
  const gpuEl = $('e-gpu');
  if (navigator.gpu) {
    try {
      const a = await navigator.gpu.requestAdapter();
      gpuEl.textContent = a ? '可用 ✓' : '无适配器';
      gpuEl.className = a ? 'ok' : 'warn';
    } catch (e) { gpuEl.textContent = '异常'; gpuEl.className = 'bad'; }
  } else {
    gpuEl.textContent = '不支持 ✗'; gpuEl.className = 'bad';
  }
  $('e-cpu').textContent = (navigator.hardwareConcurrency || '?') + ' 核';
  $('e-mem').textContent = navigator.deviceMemory ? navigator.deviceMemory + ' GB' : '未知';
})();

// 页面加载即开跑，不等用户点
setBtn('准备中…', false);
boot();

// 换模型 = 重新静默预载
$('model').onchange = () => {
  if (currentModel === $('model').value) return;
  ready = false; pipe = null; booting = null;
  setBtn('准备中…', false);
  boot();
};

async function generate() {
  if (!ready || !pipe) return;
  $('run2').disabled = true;
  $('out').textContent = '';
  $('m-speed').textContent = '速度: -';
  $('m-tokens').textContent = 'token: -';
  $('m-time').textContent = '耗时: -';

  const prompt = $('inp').value;
  const t0 = performance.now();
  let count = 0;

  try {
    const { TextStreamer } = await getLib();
    const streamer = new TextStreamer(pipe.tokenizer, {
      skip_prompt: true,
      callback_function: (txt) => {
        $('out').textContent += txt;
        count++;
        const sec = (performance.now() - t0) / 1000;
        if (sec > 0.3) $('m-speed').textContent = '速度: ' + (count / sec).toFixed(1) + ' token/s';
        $('out').scrollTop = $('out').scrollHeight;
      }
    });
    await pipe(prompt, { max_new_tokens: 120, do_sample: true, temperature: 0.7, streamer });
    const sec = (performance.now() - t0) / 1000;
    $('m-time').textContent = '耗时: ' + sec.toFixed(2) + ' s';
    $('m-tokens').textContent = 'token: ' + count;
    if (count > 0) $('m-speed').textContent = '速度: ' + (count / sec).toFixed(1) + ' token/s';
  } catch (e) {
    $('out').textContent = '生成失败：' + (e.message || e);
  } finally {
    $('run2').disabled = false;
  }
}

$('run2').onclick = generate;
</script>
</body>
</html>
